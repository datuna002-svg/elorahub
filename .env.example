# Copy this file to .env.local for local testing (Vercel CLI reads it automatically).
# In production, set this in your host's dashboard (Vercel → Project → Settings → Environment Variables).
# Never commit the real key, and never put it in any front-end file.

# AI chat — Groq (see GROQ-SETUP.md for how to get a free key — no credit card needed)
LLM_API_KEY=gsk_your-groq-key-here
# Optional overrides — leave unset to use Groq's free API with a default model:
# LLM_ENDPOINT_URL=https://api.groq.com/openai/v1/chat/completions
# LLM_MODEL=openai/gpt-oss-120b
# LLM_VISION_MODEL=qwen/qwen3.8-27b

# AI chat — Gemini (also free, no credit card — the second option in the
# in-chat model picker). Get a key at aistudio.google.com/apikey.
GEMINI_API_KEY=your-gemini-key-here
# GEMINI_MODEL=gemini-3.8-flash

# Paddle (see PADDLE-SETUP.md for how to get each of these). Paddle is
# used instead of Stripe because Stripe doesn't support Georgia-based
# accounts — Paddle acts as merchant of record and pays out to your bank.
PADDLE_API_KEY=your_paddle_api_key_here
PADDLE_CLIENT_TOKEN=live_your_client_side_token_here
PADDLE_WEBHOOK_SECRET=your_webhook_secret_here
# PADDLE_ENV=sandbox   # uncomment while testing with fake payments
PADDLE_PRICE_PRIVATE_MONTHLY=pri_xxx
PADDLE_PRICE_PRIVATE_YEARLY=pri_xxx
PADDLE_PRICE_PREMIUM_MONTHLY=pri_xxx
PADDLE_PRICE_PREMIUM_YEARLY=pri_xxx

# Supabase — real accounts, admin roles, and the error log
# (see SUPABASE-SETUP.md). SUPABASE_URL is also set client-side in
# index.html (that's fine, it's public); SUPABASE_SERVICE_ROLE_KEY is
# secret and must ONLY live here / in Vercel env vars, never in the HTML.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
