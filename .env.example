# Copy this file to .env.local for local testing (Vercel CLI reads it automatically).
# In production, set this in your host's dashboard (Vercel → Project → Settings → Environment Variables).
# Never commit the real key, and never put it in any front-end file.

ANTHROPIC_API_KEY=sk-ant-your-real-key-here

# Stripe (see STRIPE-SETUP.md for how to get each of these)
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PRICE_PRIVATE_MONTHLY=price_xxx
STRIPE_PRICE_PRIVATE_YEARLY=price_xxx
STRIPE_PRICE_PREMIUM_MONTHLY=price_xxx
STRIPE_PRICE_PREMIUM_YEARLY=price_xxx
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here
